# The Movie Database (TMDB) API Configuratie
# 
# Instructies:
# 1. Kopieër dit bestand naar .env
# 2. Voeg je TMDB API credentials in
# 3. .env file wordt gebruikt voor lokale instellingen
# 4. ZORG ERVOOR DAT .env IN .gitignore STAAT (API keys mogen niet in repo!)

# API Key voor TMDB
VITE_API_KEY=your_api_key_here

# API Read Access Token (optioneel, voor geavanceerde endpoints)
VITE_API_TOKEN=your_read_access_token_here

# Base API URL
VITE_API_BASE_URL=https://api.themoviedb.org/3

# Image base URL
VITE_IMAGE_BASE_URL=https://image.tmdb.org/t/p/
